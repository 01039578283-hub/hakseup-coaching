{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "academy-site-2\\.vercel\\.app"
        }
      ],
      "destination": "https://xn--ru4bi8s1tac0p.kr/:path",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/학습관리",
      "destination": "/학습가이드",
      "permanent": true
    }
  ],
  "buildCommand": "node release-public-build.mjs && node wawa-analytics-build.mjs wawa-03 .public-release && node seo-descriptions.mjs --root=.public-release",
  "outputDirectory": ".public-release"
}
