{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/crawl-support/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "academy-site-2\\.vercel\\.app"
        }
      ],
      "destination": "https://xn--ru4bi8s1tac0p.kr/:path",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/학습관리",
      "destination": "/학습가이드",
      "permanent": true
    },
    {
      "source": "/선생님찾기/다산점\\(W\\+\\)/",
      "destination": "https://xn--ru4bi8s1tac0p.kr/%EC%84%A0%EC%83%9D%EB%8B%98%EC%B0%BE%EA%B8%B0/%EB%8B%A4%EC%82%B0%EC%A0%90%28W%2B%29/",
      "permanent": true
    }
  ],
  "buildCommand": "node release-public-build.mjs && node wawa-analytics-build.mjs wawa-03 .public-release && node seo-descriptions.mjs --root=.public-release && node seo-metadata-consistency.mjs --root=.public-release",
  "outputDirectory": ".public-release"
}
